#!/usr/bin/env python3
"""Run unitreetop straight from this source tree (no pip install needed).

Symlink it anywhere on PATH:  ln -s "$PWD/bin/unitreetop" ~/.local/bin/unitreetop
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # follows symlinks
sys.path.insert(0, ROOT)

from unitreetop.__main__ import main  # noqa: E402

if __name__ == "__main__":
    main()
